{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "flashshop-api": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install",
      "bindings": [
        {
          "type": "service",
          "service": "frontend",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "flashshop-api"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "flashshop-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
