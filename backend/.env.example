# ===== Server & Services =====
PORT=5000
NODE_ENV=production
# FRONTEND_URL is automatically injected by Vercel Services binding
FRONTEND_URL=
CLIENT_URL=https://e-commerce-website-seven-steel.vercel.app

# ===== Database (MongoDB Atlas or Local) =====
# Supports either MONGODB_URI or MONGO_URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flashshop?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/flashshop

# ===== JWT Authentication =====
JWT_SECRET=change_this_to_a_long_random_64_char_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ===== Cloudinary (Optional image hosting) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Email (Nodemailer SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FlashShop <no-reply@flashshop.com>"

# ===== Stripe (Optional) =====
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== Razorpay (Optional) =====
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# ===== Google Gemini AI =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
