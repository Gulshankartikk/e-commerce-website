# Frontend environment (Vite exposes only VITE_* vars)
# In local development: /api/v1 (proxied by Vite to http://127.0.0.1:5000)
# In production on Vercel: https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_RAZORPAY_KEY_ID=rzp_test_xxx
